generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Person {
  id             String      @id @default(cuid())
  name           String
  gender         String      @default("MALE") // "MALE", "FEMALE", "OTHER"
  description    String?
  birthDate      String?
  isDeceased     Boolean     @default(false)
  positionX      Float?
  positionY      Float?
  
  images         NodeImage[]

  unionsAsPartner1 Union[]   @relation("Partner1Unions")
  unionsAsPartner2 Union[]   @relation("Partner2Unions")

  parentUnionId    String?
  parentUnion      Union?    @relation("UnionChildren", fields: [parentUnionId], references: [id], onDelete: SetNull)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Union {
  id           String    @id @default(cuid())
  
  partner1Id   String
  partner1     Person    @relation("Partner1Unions", fields: [partner1Id], references: [id], onDelete: Cascade)
  partner2Id   String?
  partner2     Person?   @relation("Partner2Unions", fields: [partner2Id], references: [id], onDelete: SetNull)

  children     Person[]  @relation("UnionChildren")

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model NodeImage {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}
